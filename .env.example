# Groq API Configuration
GROQ_API_KEY=your-groq-api-key-here
RESOLVEAI_MODEL=openai/gpt-oss-120b

# Server Configuration
RESOLVEAI_HOST=127.0.0.1
RESOLVEAI_PORT=8000
RESOLVEAI_DEBUG=false

# Database
RESOLVEAI_DB=./resolveai.db

# Authentication (set both for production)
RESOLVEAI_API_KEY=
RESOLVEAI_JWT_SECRET=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Email Notifications (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@resolveai.local
EMAIL_TO=

# Uploads
RESOLVEAI_UPLOADS=./uploads
